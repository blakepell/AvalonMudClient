<wpf:MosaicApp
    x:Class="Avalon.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:vm="clr-namespace:Avalon.Common"
    xmlns:wpf="clr-namespace:Mosaic.UI.Wpf;assembly=Mosaic.UI.Wpf"
    xmlns:xamlFlair="clr-namespace:XamlFlair;assembly=XamlFlair.WPF"
    x:TypeArguments="vm:AppSettings, vm:AppViewModel"
    Exit="Application_Exit"
    ShutdownMode="OnMainWindowClose"
    Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <xamlFlair:XamlFlairResources />
                <ui:XamlControlsResources />

                <!-- Legacy resources remain available to custom Avalon controls.
                     Mosaic owns native controls, windows, and live theme switching. -->
                <ResourceDictionary Source="Resources/EditorTextBoxStyles.xaml" />
                <ResourceDictionary Source="/Avalon;component/Controls/SearchBox/SearchBox.xaml" />
                <ResourceDictionary Source="/Avalon;component/Resources/MosaicStyles.xaml" />
                <ResourceDictionary Source="/Avalon;component/Resources/Geometries.xaml" />

                <mosaic:ThemeManager
                    Native="True"
                    SystemColors="True"
                    Theme="Dark" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</wpf:MosaicApp>
