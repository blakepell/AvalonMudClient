<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui">

    <!--
        Shared Mosaic styles for the Avalon dialogs.  Everything in here pulls from MosaicTheme
        tokens via DynamicResource so that a live theme switch flows through the whole app.  Do
        not hard code colors here, add a Mosaic token instead.
    -->

    <!--  Status bar that sits along the bottom of the editor dialogs.  -->
    <Style x:Key="MosaicStatusBar" TargetType="{x:Type StatusBar}">
        <Setter Property="Background" Value="{DynamicResource {x:Static mosaic:MosaicTheme.AccentBrush}}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static mosaic:MosaicTheme.FontSizeSmall}}" />
    </Style>

    <!--  Label that sits above an input field in the editor dialogs.  -->
    <Style x:Key="MosaicFieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static mosaic:MosaicTheme.ControlTextSecondaryForegroundBrush}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static mosaic:MosaicTheme.FontSizeSmall}}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--  Label that sits to the left of an input field in the editor dialogs.  -->
    <Style
        x:Key="MosaicInlineFieldLabel"
        BasedOn="{StaticResource MosaicFieldLabel}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Footer that holds the Cancel / Save actions of a dialog.  -->
    <Style x:Key="MosaicDialogFooter" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource {x:Static mosaic:MosaicTheme.MessageBoxFooterBackgroundBrush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static mosaic:MosaicTheme.ControlSeparatorBrush}}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!--
        Form section inside a dialog.  ContentPanel always reserves a footer row, so the footer is
        made transparent here since these sections never carry footer content.
    -->
    <Style x:Key="MosaicFormPanel" TargetType="{x:Type mosaic:ContentPanel}">
        <Setter Property="FooterBackground" Value="Transparent" />
    </Style>

    <!--  Standard sizing for the action buttons that live in a dialog footer.  -->
    <Style x:Key="MosaicDialogButton" TargetType="{x:Type mosaic:AccentButton}">
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="5,10" />
    </Style>

    <!--
        Mosaic title bar and chrome.  This is a keyed style rather than an implicit one because
        WPF matches implicit styles on the element's exact type, so an implicit Window style would
        never reach any of the Window subclasses in this app.  Apply it with
        Style="{StaticResource MosaicWindow}" on any window that does not build its own title bar.
        Windows using AllowsTransparency="True" must not use it, WindowChrome and layered windows
        do not mix.
    -->
    <Style x:Key="MosaicWindow" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static mosaic:MosaicTheme.WindowForegroundBrush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="mosaic:WindowChromeBehavior.ApplyThemeWindowBrushes" Value="True" />
        <Setter Property="mosaic:WindowChromeBehavior.CaptionHeight" Value="0" />
        <Setter Property="mosaic:WindowChromeBehavior.CornerRadius" Value="10" />
        <Setter Property="mosaic:WindowChromeBehavior.GlassFrameThickness" Value="0" />
        <Setter Property="mosaic:WindowChromeBehavior.IsEnabled" Value="True" />
        <Setter Property="mosaic:WindowChromeBehavior.ResizeBorderThickness" Value="5" />
        <Setter Property="mosaic:WindowChromeBehavior.UseAeroCaptionButtons" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <mosaic:WindowTitleBar
                                Grid.Row="0"
                                IconSource="{TemplateBinding Icon}"
                                TitleText="{TemplateBinding Title}" />
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
