<Window
    x:Class="Avalon.RegexTestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    Title="Regular Expression Tester"
    Width="820"
    Height="500"
    MinWidth="600"
    MinHeight="400"
    TextOptions.TextFormattingMode="Ideal"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <mosaic:InertiaScrollViewer
            Grid.Row="0"
            Padding="14,12"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <mosaic:SimpleStackPanel Orientation="Vertical" Spacing="10">
                <mosaic:ContentPanel Style="{StaticResource MosaicFormPanel}" Title="Pattern">
                    <TextBox
                        x:Name="TextBoxRegexPattern"
                        AcceptsReturn="False"
                        FontFamily="Cascadia Mono, Consolas, Courier New"
                        TextChanged="TextBox_TextChanged" />
                </mosaic:ContentPanel>

                <mosaic:ContentPanel Style="{StaticResource MosaicFormPanel}" Title="Test Text">
                    <mosaic:SimpleStackPanel Orientation="Vertical" Spacing="6">
                        <RichTextBox
                            x:Name="TextBoxTest1"
                            AcceptsReturn="False"
                            TextChanged="TextBox_TextChanged" />
                        <RichTextBox
                            x:Name="TextBoxTest2"
                            AcceptsReturn="False"
                            TextChanged="TextBox_TextChanged" />
                        <RichTextBox
                            x:Name="TextBoxTest3"
                            AcceptsReturn="False"
                            TextChanged="TextBox_TextChanged" />
                        <RichTextBox
                            x:Name="TextBoxTest4"
                            AcceptsReturn="False"
                            TextChanged="TextBox_TextChanged" />
                        <RichTextBox
                            x:Name="TextBoxTest5"
                            AcceptsReturn="False"
                            TextChanged="TextBox_TextChanged" />
                        <RichTextBox
                            x:Name="TextBoxTest6"
                            AcceptsReturn="False"
                            TextChanged="TextBox_TextChanged" />
                        <RichTextBox
                            x:Name="TextBoxTest7"
                            AcceptsReturn="False"
                            TextChanged="TextBox_TextChanged" />
                    </mosaic:SimpleStackPanel>
                </mosaic:ContentPanel>
            </mosaic:SimpleStackPanel>
        </mosaic:InertiaScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource MosaicDialogFooter}">
            <mosaic:SimpleStackPanel
                Margin="8,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <mosaic:AccentButton
                    x:Name="ButtonCancel"
                    AccentButtonType="Gray"
                    Click="ButtonCancel_OnClick"
                    Content="Cancel"
                    Style="{StaticResource MosaicDialogButton}" />
                <mosaic:AccentButton
                    x:Name="ButtonSave"
                    AccentButtonType="ThemeAccent"
                    Click="ButtonSave_OnClick"
                    Content="Save"
                    IsDefault="True"
                    Style="{StaticResource MosaicDialogButton}"
                    Visibility="{Binding SaveButtonVisible}" />
            </mosaic:SimpleStackPanel>
        </Border>

        <StatusBar
            x:Name="StatusBarWindow"
            Grid.Row="2"
            Style="{StaticResource MosaicStatusBar}">
            <TextBlock
                x:Name="TextBlockStatus"
                Text=""
                TextWrapping="NoWrap" />
        </StatusBar>
    </Grid>
</Window>
