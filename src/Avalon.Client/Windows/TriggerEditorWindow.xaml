<Window
    x:Class="Avalon.TriggerEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    xmlns:models="clr-namespace:Avalon.Common.Models;assembly=Avalon.Common"
    xmlns:utilities="clr-namespace:Avalon.Utilities"
    Title="Trigger Editor"
    Width="820"
    Height="640"
    MinWidth="640"
    MinHeight="480"
    Loaded="TriggerEditorWindow_Loaded"
    TextOptions.TextFormattingMode="Ideal"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <ObjectDataProvider
                x:Key="ExecuteTypes"
                MethodName="GetValuesAndDescriptions"
                ObjectType="utilities:EnumUtility">
                <ObjectDataProvider.MethodParameters>
                    <x:TypeExtension TypeName="models:ExecuteType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <mosaic:InertiaScrollViewer
            Grid.Row="0"
            Padding="14,12,14,12"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <mosaic:SimpleStackPanel Orientation="Vertical" Spacing="12">

                <!--  Pattern and command.  -->
                <mosaic:ContentPanel Title="Match and Execute">
                    <mosaic:SimpleStackPanel Orientation="Vertical" Spacing="10">
                        <mosaic:SimpleStackPanel Orientation="Vertical">
                            <TextBlock Style="{StaticResource MosaicFieldLabel}" Text="Pattern" />
                            <DockPanel Height="32" LastChildFill="True">
                                <mosaic:AccentButton
                                    x:Name="ButtonTest"
                                    Width="72"
                                    Margin="0,0,6,0"
                                    AccentButtonType="ThemeAccent"
                                    Click="ButtonTest_Click"
                                    Content="Test"
                                    DockPanel.Dock="Left"
                                    ToolTip="Test this pattern in the regular expression tester." />
                                <TextBox x:Name="TextPattern" VerticalContentAlignment="Center" />
                            </DockPanel>
                        </mosaic:SimpleStackPanel>

                        <mosaic:SimpleStackPanel Orientation="Vertical">
                            <TextBlock Style="{StaticResource MosaicFieldLabel}" Text="Command" />
                            <DockPanel Height="32" LastChildFill="True">
                                <mosaic:AccentButton
                                    x:Name="ButtonEdit"
                                    Width="72"
                                    Margin="0,0,6,0"
                                    AccentButtonType="ThemeAccent"
                                    Click="ButtonEdit_Click"
                                    Content="Edit"
                                    DockPanel.Dock="Left"
                                    ToolTip="Edit the command in the full screen editor." />
                                <TextBox x:Name="TextCommand" VerticalContentAlignment="Center" />
                            </DockPanel>
                        </mosaic:SimpleStackPanel>
                    </mosaic:SimpleStackPanel>
                </mosaic:ContentPanel>

                <!--  Metadata about where and when the trigger runs.  -->
                <mosaic:ContentPanel Title="Details">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <mosaic:SimpleStackPanel Grid.Row="0" Grid.Column="0" Orientation="Vertical">
                            <TextBlock Style="{StaticResource MosaicFieldLabel}" Text="Group" />
                            <TextBox x:Name="TextGroup" />
                        </mosaic:SimpleStackPanel>

                        <mosaic:SimpleStackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical">
                            <TextBlock Style="{StaticResource MosaicFieldLabel}" Text="Character" />
                            <TextBox x:Name="TextCharacter" />
                        </mosaic:SimpleStackPanel>

                        <mosaic:SimpleStackPanel Grid.Row="2" Grid.Column="0" Orientation="Vertical">
                            <TextBlock Style="{StaticResource MosaicFieldLabel}" Text="Identifier" />
                            <TextBox x:Name="TextIdentifier" IsReadOnly="True" />
                        </mosaic:SimpleStackPanel>

                        <mosaic:SimpleStackPanel Grid.Row="2" Grid.Column="2" Orientation="Vertical">
                            <TextBlock Style="{StaticResource MosaicFieldLabel}" Text="Redirect To" />
                            <ComboBox
                                x:Name="ComboBoxRedirectTo"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Value"
                                SelectedIndex="0"
                                SelectedValuePath="Key" />
                        </mosaic:SimpleStackPanel>

                        <mosaic:SimpleStackPanel Grid.Row="4" Grid.Column="0" Orientation="Vertical">
                            <TextBlock Style="{StaticResource MosaicFieldLabel}" Text="Priority" />
                            <mosaic:NumericTextBox x:Name="TextPriority" DecimalPlaces="0" />
                        </mosaic:SimpleStackPanel>

                        <mosaic:SimpleStackPanel Grid.Row="4" Grid.Column="2" Orientation="Vertical">
                            <TextBlock Style="{StaticResource MosaicFieldLabel}" Text="Execute As" />
                            <ComboBox
                                x:Name="ComboBoxExecuteAs"
                                HorizontalAlignment="Stretch"
                                DisplayMemberPath="Value"
                                SelectedIndex="0"
                                SelectedValuePath="Key" />
                        </mosaic:SimpleStackPanel>
                    </Grid>
                </mosaic:ContentPanel>

                <!--  Behavior toggles.  -->
                <mosaic:ContentPanel Title="Options">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox
                            x:Name="CheckBoxEnabled"
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,3"
                            Content="Enabled" />
                        <CheckBox
                            x:Name="CheckBoxGag"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,3"
                            Content="Gag" />
                        <CheckBox
                            x:Name="CheckBoxVariableReplace"
                            Grid.Row="0"
                            Grid.Column="2"
                            Margin="0,3"
                            Content="Variable Replace" />

                        <CheckBox
                            x:Name="CheckBoxStopProcessing"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,3"
                            Content="Stop Processing" />
                        <CheckBox
                            x:Name="CheckBoxLock"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,3"
                            Content="Lock" />
                        <CheckBox
                            x:Name="CheckBoxHighlight"
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,3"
                            Content="Highlight" />

                        <CheckBox
                            x:Name="CheckBoxSilent"
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,3"
                            Content="Silent" />
                        <CheckBox
                            x:Name="CheckBoxDisableAfterTriggered"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,3"
                            Content="Disable after Triggered" />
                        <CheckBox
                            x:Name="CheckBoxLineTransformer"
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="0,3"
                            Content="Line Transformer" />

                        <CheckBox
                            x:Name="CheckBoxTemp"
                            Grid.Row="3"
                            Grid.Column="0"
                            Margin="0,3"
                            Content="Temp" />
                    </Grid>
                </mosaic:ContentPanel>

            </mosaic:SimpleStackPanel>
        </mosaic:InertiaScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource MosaicDialogFooter}">
            <mosaic:SimpleStackPanel
                Margin="8,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <mosaic:AccentButton
                    x:Name="ButtonCancel"
                    AccentButtonType="Gray"
                    Click="ButtonCancel_OnClick"
                    Content="Cancel"
                    Style="{StaticResource MosaicDialogButton}" />
                <mosaic:AccentButton
                    x:Name="ButtonSave"
                    AccentButtonType="ThemeAccent"
                    Click="ButtonSave_OnClick"
                    Content="Save"
                    IsDefault="True"
                    Style="{StaticResource MosaicDialogButton}" />
            </mosaic:SimpleStackPanel>
        </Border>

        <StatusBar Grid.Row="2" Style="{StaticResource MosaicStatusBar}">
            <TextBlock
                x:Name="TextBlockStatus"
                Text="Trigger Editor"
                TextWrapping="NoWrap" />
        </StatusBar>
    </Grid>
</Window>
