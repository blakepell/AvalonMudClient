<Window
    x:Class="Avalon.CreatePackageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Avalon.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    Title="Create Package"
    Width="900"
    Height="520"
    MinWidth="640"
    MinHeight="400"
    TextOptions.TextFormattingMode="Ideal"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <mosaic:TabControl x:Name="TabMain" Grid.Row="0">
            <TabItem x:Name="TabAliases" Header="Aliases">
                <controls:AliasList x:Name="AliasList" />
            </TabItem>
            <TabItem x:Name="TabTriggers" Header="Triggers">
                <controls:TriggerList x:Name="TriggerList" />
            </TabItem>
            <TabItem x:Name="TabDirections" Header="Directions">
                <controls:DirectionList x:Name="DirectionList" />
            </TabItem>
        </mosaic:TabControl>

        <Border Grid.Row="1" Style="{StaticResource MosaicDialogFooter}">
            <mosaic:SimpleStackPanel
                Margin="8,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <mosaic:AccentButton
                    x:Name="ButtonCancel"
                    AccentButtonType="Gray"
                    Click="ButtonCancel_Click"
                    Content="Cancel"
                    Style="{StaticResource MosaicDialogButton}" />
                <mosaic:AccentButton
                    x:Name="ButtonCreate"
                    AccentButtonType="ThemeAccent"
                    Click="ButtonCreate_Click"
                    Content="Create"
                    IsDefault="True"
                    Style="{StaticResource MosaicDialogButton}" />
            </mosaic:SimpleStackPanel>
        </Border>

        <StatusBar Grid.Row="2" Style="{StaticResource MosaicStatusBar}">
            <TextBlock
                x:Name="TextBlockStatus"
                Text="Use Ctrl and a mouse click to select multiple items."
                TextWrapping="NoWrap" />
        </StatusBar>
    </Grid>
</Window>
