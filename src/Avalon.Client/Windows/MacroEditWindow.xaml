<Window
    x:Class="Avalon.MacroEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    Title="Macro Editor"
    Width="600"
    Height="240"
    Loaded="StringEditorWindow_Loaded"
    TextOptions.TextFormattingMode="Ideal"
    Style="{StaticResource MosaicWindow}"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <mosaic:SimpleStackPanel
            Grid.Row="0"
            Margin="14,12"
            Orientation="Vertical"
            Spacing="10">
            <DockPanel LastChildFill="True">
                <TextBlock
                    Width="100"
                    Style="{StaticResource MosaicInlineFieldLabel}"
                    Text="Macro Key:" />
                <TextBox
                    x:Name="TextBoxMacroKey"
                    AcceptsReturn="False"
                    KeyDown="TextBoxMacroKey_KeyDown"
                    PreviewKeyDown="TextBoxMacroKey_PreviewKeyDown" />
            </DockPanel>
            <DockPanel LastChildFill="True">
                <TextBlock
                    Width="100"
                    Style="{StaticResource MosaicInlineFieldLabel}"
                    Text="Command:" />
                <TextBox x:Name="TextBoxCommand" AcceptsReturn="False" />
            </DockPanel>
        </mosaic:SimpleStackPanel>

        <Border Grid.Row="1" Style="{StaticResource MosaicDialogFooter}">
            <mosaic:SimpleStackPanel
                Margin="8,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <mosaic:AccentButton
                    x:Name="ButtonCancel"
                    AccentButtonType="Gray"
                    Click="ButtonCancel_OnClick"
                    Content="Cancel"
                    Style="{StaticResource MosaicDialogButton}" />
                <mosaic:AccentButton
                    x:Name="ButtonSave"
                    AccentButtonType="ThemeAccent"
                    Click="ButtonSave_OnClick"
                    Content="Save"
                    IsDefault="True"
                    Style="{StaticResource MosaicDialogButton}"
                    Visibility="{Binding SaveButtonVisible}" />
            </mosaic:SimpleStackPanel>
        </Border>

        <StatusBar
            x:Name="StatusBarWindow"
            Grid.Row="2"
            Style="{StaticResource MosaicStatusBar}">
            <TextBlock
                x:Name="TextBlockStatus"
                Text=""
                TextWrapping="NoWrap" />
        </StatusBar>
    </Grid>
</Window>
