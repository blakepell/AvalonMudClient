<Window
    x:Class="Avalon.ListManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Avalon.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    Title="List Manager"
    Width="600"
    Height="440"
    MinWidth="420"
    MinHeight="320"
    TextOptions.TextFormattingMode="Ideal"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <local:ListManager x:Name="ListMan" Grid.Row="0" />

        <Border Grid.Row="1" Style="{StaticResource MosaicDialogFooter}">
            <mosaic:SimpleStackPanel
                Margin="8,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <mosaic:AccentButton
                    x:Name="ButtonCancel"
                    AccentButtonType="Gray"
                    Click="ButtonCancel_OnClick"
                    Content="Cancel"
                    Style="{StaticResource MosaicDialogButton}" />
                <mosaic:AccentButton
                    x:Name="ButtonSave"
                    AccentButtonType="ThemeAccent"
                    Click="ButtonSave_OnClick"
                    Content="Save"
                    IsDefault="True"
                    Style="{StaticResource MosaicDialogButton}"
                    Visibility="{Binding SaveButtonVisible}" />
            </mosaic:SimpleStackPanel>
        </Border>

        <StatusBar
            x:Name="StatusBarWindow"
            Grid.Row="2"
            Style="{StaticResource MosaicStatusBar}">
            <TextBlock
                x:Name="TextBlockStatus"
                Text=""
                TextWrapping="NoWrap" />
        </StatusBar>
    </Grid>
</Window>
