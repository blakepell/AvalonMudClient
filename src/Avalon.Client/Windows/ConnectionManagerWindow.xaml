<Window
    x:Class="Avalon.ConnectionManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Avalon.Controls"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    Title="Choose your path"
    Width="900"
    Height="600"
    mosaic:WindowChromeBehavior.ApplyThemeWindowBrushes="True"
    mosaic:WindowChromeBehavior.CaptionHeight="0"
    mosaic:WindowChromeBehavior.CornerRadius="10"
    mosaic:WindowChromeBehavior.GlassFrameThickness="0"
    mosaic:WindowChromeBehavior.IsEnabled="True"
    mosaic:WindowChromeBehavior.ResizeBorderThickness="5"
    mosaic:WindowChromeBehavior.UseAeroCaptionButtons="True"
    Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}"
    BorderThickness="0"
    Closing="ConnectionManagerWindow_OnClosing"
    Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.WindowForegroundBrush}}"
    Loaded="ConnectionManagerWindow_OnLoaded"
    ResizeMode="NoResize"
    SnapsToDevicePixels="True"
    Style="{x:Null}"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="ProfilesTemplate">
            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:AvalonSword
                    Grid.RowSpan="3"
                    Margin="4,2,10,2"
                    AccentColor="{Binding AccentColor}"
                    ViewBoxHeight="48"
                    ViewBoxWidth="48" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{Binding GameDescription, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,3,0,0"
                    Opacity="0.72">
                    <Run Text="{Binding GameAddress, Mode=OneWay}" />
                    <Run Text=":" />
                    <Run Text="{Binding GamePort, Mode=OneWay}" />
                </TextBlock>
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,2,0,0"
                    Opacity="0.72"
                    Text="{Binding LastSaveDate, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <mosaic:WindowTitleBar
            Grid.Row="0"
            ShowIcon="False"
            ShowMaxRestoreButton="False"
            TitleAlignment="Center"
            TitleText="Choose your path">
            <mosaic:WindowTitleBar.RightContent>
                <Button
                    Width="48"
                    Click="ButtonToggleTheme_OnClick"
                    Content="&#x25D0;"
                    FontSize="17"
                    Style="{DynamicResource {x:Static mosaic:MosaicTheme.WindowTitleBarButtonStyle}}"
                    ToolTip="Toggle dark and blue themes" />
            </mosaic:WindowTitleBar.RightContent>
        </mosaic:WindowTitleBar>

        <Border
            Grid.Row="1"
            Padding="18,14"
            Background="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBackgroundBrush}}"
            BorderBrush="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <controls:AvalonSword
                    Width="56"
                    Height="56"
                    AccentColor="Green" />
                <StackPanel Grid.Column="1" Margin="14,3,20,0">
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="Avalon Mud Client" />
                    <TextBlock
                        Margin="1,2,0,0"
                        Opacity="0.72"
                        Text="{Binding ViewModel.Version}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Click="ButtonNewProfile_OnClick"
                        Content="New Profile" />
                    <Button
                        MinWidth="112"
                        Margin="0,0,8,0"
                        Click="ButtonReportBug_OnClick"
                        Content="Report a Bug" />
                    <Menu VerticalAlignment="Center" Background="Transparent">
                        <MenuItem Header="_Folders">
                            <MenuItem Click="MenuItemOpenClientSettingsFolder_OnClick" Header="Client Settings Folder" />
                            <MenuItem Click="MenuItemOpenProfilesFolder_OnClick" Header="Profiles Folder" />
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border
                Margin="0,0,4,0"
                BorderBrush="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}"
                BorderThickness="1">
                <ListBox
                    x:Name="GridViewProfiles"
                    HorizontalContentAlignment="Stretch"
                    ItemTemplate="{StaticResource ProfilesTemplate}"
                    ItemsSource="{Binding ViewModel.Profiles}"
                    SelectedItem="{Binding ViewModel.SelectedProfile, Mode=TwoWay}"
                    SelectionMode="Single" />
            </Border>

            <Border
                Grid.Column="1"
                Padding="22,18"
                Background="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBackgroundBrush}}"
                BorderBrush="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        FontSize="23"
                        FontWeight="SemiBold"
                        Text="{Binding ViewModel.SelectedProfile.GameDescription}"
                        TextTrimming="CharacterEllipsis" />
                    <Separator Grid.Row="1" Margin="0,8,0,16" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock VerticalAlignment="Center" Text="Game Description:" />
                        <TextBox Grid.Column="1" Margin="0,0,0,8" Text="{Binding ViewModel.SelectedProfile.GameDescription, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="IP Address:" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ViewModel.SelectedProfile.GameAddress, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Port:" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ViewModel.SelectedProfile.GamePort, Mode=TwoWay}" />
                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="File:" />
                        <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="{Binding ViewModel.SelectedProfile.Filename}" />
                        <TextBlock Grid.Row="4" Margin="0,6,0,0" VerticalAlignment="Center" Text="Profile Size:" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,6,0,0" VerticalAlignment="Center" Text="{Binding ViewModel.SelectedProfile.ProfileSize}" />
                    </Grid>

                    <Button
                        Grid.Row="3"
                        MinHeight="34"
                        Margin="0,14,0,0"
                        Click="ButtonPlay_OnClick"
                        Content="Play" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
