<Window
    x:Class="Avalon.StringEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    Title="Editor"
    Width="820"
    Height="500"
    MinWidth="500"
    MinHeight="300"
    Loaded="StringEditorWindow_Loaded"
    TextOptions.TextFormattingMode="Ideal"
    Unloaded="StringEditor_OnUnloaded"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <Window.Resources>
        <ContextMenu x:Key="ContextMenuTextUtilities" x:Shared="true">
            <MenuItem Click="MenuItemEscapeString_OnClick" Header="Escape String" />
            <MenuItem Click="MenuItemUnescapeString_OnClick" Header="Unescape String" />
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <mosaic:SyntaxEditor
            x:Name="AvalonLuaEditor"
            Grid.Row="0"
            ClearVisible="False"
            ContextMenu="{StaticResource ContextMenuTextUtilities}"
            FollowGlobalTheme="True"
            IsReadOnly="False"
            KeyDown="AvalonLuaEditor_KeyDown"
            ScrollViewer.PanningMode="VerticalOnly"
            ShowLineNumbers="True"
            WordWrap="False" />

        <Border Grid.Row="1" Style="{StaticResource MosaicDialogFooter}">
            <mosaic:SimpleStackPanel
                Margin="8,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <mosaic:AccentButton
                    x:Name="ButtonCancel"
                    AccentButtonType="Gray"
                    Click="ButtonCancel_OnClick"
                    Content="Cancel"
                    Style="{StaticResource MosaicDialogButton}" />
                <mosaic:AccentButton
                    x:Name="ButtonSave"
                    AccentButtonType="ThemeAccent"
                    Click="ButtonSave_OnClick"
                    Content="Save"
                    Style="{StaticResource MosaicDialogButton}" />
            </mosaic:SimpleStackPanel>
        </Border>

        <StatusBar Grid.Row="2" Style="{StaticResource MosaicStatusBar}">
            <TextBlock
                x:Name="TextBlockStatus"
                Text=""
                TextWrapping="NoWrap" />
        </StatusBar>
    </Grid>
</Window>
