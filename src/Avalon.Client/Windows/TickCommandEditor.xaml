<Window
    x:Class="Avalon.TickCommandEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    Title="Tick Command Editor"
    Width="620"
    Height="340"
    MinWidth="480"
    MinHeight="260"
    Loaded="TickCommandEditorWindow_Loaded"
    TextOptions.TextFormattingMode="Ideal"
    Style="{StaticResource MosaicWindow}"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <mosaic:SyntaxEditor
            x:Name="AvalonCommandEditor"
            Grid.Row="0"
            ClearVisible="False"
            FollowGlobalTheme="True"
            IsReadOnly="False"
            ScrollViewer.PanningMode="VerticalOnly"
            ShowLineNumbers="True"
            WordWrap="False" />

        <Border Grid.Row="1" Style="{StaticResource MosaicDialogFooter}">
            <DockPanel Margin="8,0" LastChildFill="False">
                <CheckBox
                    x:Name="CheckBoxEnabled"
                    VerticalAlignment="Center"
                    Content="Enable Tick Commands"
                    DockPanel.Dock="Left" />
                <mosaic:AccentButton
                    x:Name="ButtonSave"
                    AccentButtonType="ThemeAccent"
                    Click="ButtonSave_OnClick"
                    Content="Save"
                    DockPanel.Dock="Right"
                    IsDefault="True"
                    Style="{StaticResource MosaicDialogButton}" />
                <mosaic:AccentButton
                    x:Name="ButtonCancel"
                    AccentButtonType="Gray"
                    Click="ButtonCancel_OnClick"
                    Content="Cancel"
                    DockPanel.Dock="Right"
                    Style="{StaticResource MosaicDialogButton}" />
            </DockPanel>
        </Border>

        <StatusBar Grid.Row="2" Style="{StaticResource MosaicStatusBar}">
            <TextBlock
                x:Name="TextBlockStatus"
                Text="Info: Commands to Execute on Tick"
                TextWrapping="NoWrap" />
        </StatusBar>
    </Grid>
</Window>
