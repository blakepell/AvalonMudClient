<Window
    x:Class="Avalon.MainWindow"
    x:Name="mainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ad="https://github.com/blakepell/MosaicUIWpf"
    xmlns:controls="clr-namespace:Avalon.Controls"
    xmlns:editors="clr-namespace:Avalon.Controls.AutoCompleteTextBox.Editors"
    xmlns:local="clr-namespace:Avalon"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    Activated="MainWindow_Activated"
    Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}"
    BorderThickness="0"
    Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.WindowForegroundBrush}}"
    Height="720"
    Loaded="MainWindow_Loaded"
    MinHeight="600"
    MinWidth="900"
    mosaic:WindowChromeBehavior.CaptionHeight="0"
    mosaic:WindowChromeBehavior.CornerRadius="10"
    mosaic:WindowChromeBehavior.GlassFrameThickness="0"
    mosaic:WindowChromeBehavior.IsEnabled="True"
    mosaic:WindowChromeBehavior.ResizeBorderThickness="5"
    mosaic:WindowChromeBehavior.UseAeroCaptionButtons="True"
    Opacity="0"
    PreviewKeyDown="MainWindow_OnPreviewKeyDown"
    ShowInTaskbar="False"
    SizeChanged="MainPage_SizeChanged"
    SnapsToDevicePixels="True"
    Style="{x:Null}"
    TextOptions.TextFormattingMode="Ideal"
    Title="{Binding ProfileSettings.WindowTitle}"
    UseLayoutRounding="True"
    Width="1120">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Avalon;component/Controls/AutoCompleteTextBox/AutoCompleteStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <DataTemplate x:Key="AutoCompleteCommandTemplate">
                <TextBlock Text="{Binding Command}" />
            </DataTemplate>
            <ContextMenu x:Key="AvalonTerminalContextMenu" x:Shared="True">
                <MenuItem Click="AvalonTerminalContextMenuCopy_OnClick" Header="Copy" />
                <MenuItem Click="AvalonTerminalContextMenuCopyWithMudColors_OnClick" Header="Copy with MUD Colors" />
                <Separator />
                <MenuItem Click="MenuItemTestSelectionRegEx_Click" Header="Test Selection in Regular Expression Tester" />
                <Separator />
                <MenuItem Click="MenuItemIncreaseFontSize_OnClick" Header="Font Size Larger" InputGestureText="Ctrl+Plus" />
                <MenuItem Click="MenuItemDecreaseFontSize_OnClick" Header="Font Size Smaller" InputGestureText="Ctrl+Minus" />
                <Separator />
                <MenuItem Click="AvalonTerminalContextMenuClear_OnClick" Header="Clear Terminal" />
            </ContextMenu>
        </ResourceDictionary>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="local:MainWindow.LoadPlugin" Executed="MenuItemManuallyLoadPlugin_Click" />
        <CommandBinding Command="local:MainWindow.EditLastItem" Executed="MenuItemOpenLastEditedAliasOrTrigger_Click" />
        <CommandBinding Command="local:MainWindow.SelectElement" Executed="SelectElementInternal" />
        <CommandBinding Command="local:MainWindow.FontSizeChange" Executed="ChangeTerminalFontSize" />
        <CommandBinding Command="local:MainWindow.FocusByName" Executed="FocusByNameInternal" />
        <CommandBinding Command="local:MainWindow.ShellWindow" Executed="ShellWindowInternal" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="local:MainWindow.ShellWindow" CommandParameter="Aliases" Key="A" Modifiers="Ctrl+Alt" />
        <KeyBinding Command="local:MainWindow.ShellWindow" CommandParameter="Triggers" Key="T" Modifiers="Ctrl+Alt" />
        <KeyBinding Command="local:MainWindow.ShellWindow" CommandParameter="Macros" Key="M" Modifiers="Ctrl+Alt" />
        <KeyBinding Command="local:MainWindow.ShellWindow" CommandParameter="Variables" Key="V" Modifiers="Ctrl+Alt" />
        <KeyBinding Command="local:MainWindow.ShellWindow" CommandParameter="Directions" Key="D" Modifiers="Ctrl+Alt" />
        <KeyBinding Command="local:MainWindow.FocusByName" CommandParameter="TextInput" Key="I" Modifiers="Ctrl" />
        <KeyBinding Command="local:MainWindow.ShellWindow" CommandParameter="Directions Select" Key="D" Modifiers="Ctrl" />
        <KeyBinding Command="local:MainWindow.LoadPlugin" Key="P" Modifiers="Ctrl+Alt" />
        <KeyBinding Command="local:MainWindow.EditLastItem" Key="L" Modifiers="Ctrl+Alt" />
        <KeyBinding Command="local:MainWindow.SelectElement" CommandParameter="Terminal1" Key="D1" Modifiers="Ctrl" />
        <KeyBinding Command="local:MainWindow.SelectElement" CommandParameter="Terminal2" Key="D2" Modifiers="Ctrl" />
        <KeyBinding Command="local:MainWindow.SelectElement" CommandParameter="Terminal3" Key="D3" Modifiers="Ctrl" />
        <KeyBinding Command="local:MainWindow.FontSizeChange" CommandParameter="+" Key="OemPlus" Modifiers="Ctrl" />
        <KeyBinding Command="local:MainWindow.FontSizeChange" CommandParameter="-" Key="OemMinus" Modifiers="Ctrl" />
        <KeyBinding Command="{Binding ToggleConnectCommand}" Key="N" Modifiers="Ctrl" />
    </Window.InputBindings>

    <Grid Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
            <RowDefinition Height="34" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <mosaic:WindowTitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            ShowIcon="False"
            TitleAlignment="Center"
            TitleText="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
            <mosaic:WindowTitleBar.RightContent>
                <Button
                    Width="48"
                    Click="ButtonToggleTheme_OnClick"
                    Content="&#x25D0;"
                    FontSize="17"
                    Style="{DynamicResource {x:Static mosaic:MosaicTheme.WindowTitleBarButtonStyle}}"
                    ToolTip="Toggle dark and blue themes" />
            </mosaic:WindowTitleBar.RightContent>
        </mosaic:WindowTitleBar>

        <!-- The former hamburger actions now live in this single regular menu. -->
        <DockPanel Grid.Row="1" Margin="4,0,4,0">
            <Menu x:Name="MenuGame">
            <MenuItem Header="_File">
                <MenuItem Click="MenuItemConnectionManager_OnClick" Header="Connection Manager" />
                <MenuItem x:Name="MenuNetworkButton" Click="MenuNetworkButton_Click" Header="Connect" />
                <Separator />
                <MenuItem Click="MenuItemCreatePackage_Click" Header="Create Package" />
                <MenuItem Header="Storage Folders">
                    <MenuItem Click="MenuItemOpenSettingsFolderAsync_Click" Header="Open Settings Folder" />
                    <MenuItem Click="MenuItemOpenProfilesFolderAsync_Click" Header="Open Profiles Folder" />
                    <MenuItem Click="MenuItemOpenPluginsFolderAsync_Click" Header="Open Plugins Folder" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ButtonOpenProfile" Click="ButtonOpenProfile_OnClick" Header="_Open Profile" />
                <MenuItem x:Name="ButtonImportPackage" Click="ButtonImportPackage_OnClickAsync" Header="Import Package" />
                <MenuItem x:Name="ButtonSaveProfile" Click="ButtonSaveProfile_OnClick" Header="_Save Profile" />
                <Separator />
                <MenuItem x:Name="ButtonExitWithoutSave" Click="ButtonExitWithoutSave_OnClickAsync" Header="Exit Without Save" />
                <MenuItem x:Name="ButtonExit" Click="ButtonExit_OnClick" Header="E_xit" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Click="MenuItemChangeCharacter_Click" Header="Change Character" />
                <Separator />
                <MenuItem Click="MenuShellWindow_Click" Header="Edit _Aliases" InputGestureText="Ctrl+Alt+A" Tag="Aliases" />
                <MenuItem Click="MenuShellWindow_Click" Header="Edit _Directions" InputGestureText="Ctrl+Alt+D" Tag="Directions" />
                <MenuItem Click="MenuShellWindow_Click" Header="Edit _Macros" InputGestureText="Ctrl+Alt+M" Tag="Macros" />
                <MenuItem Click="MenuShellWindow_Click" Header="Edit _Triggers" InputGestureText="Ctrl+Alt+T" Tag="Triggers" />
                <MenuItem Click="MenuShellWindow_Click" Header="Edit _Variables" InputGestureText="Ctrl+Alt+V" Tag="Variables" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Click="MenuItemOpenLastEditedAliasOrTrigger_Click" Header="Open Last Edited Alias or Trigger" InputGestureText="Ctrl+Alt+L" />
                <Separator />
                <MenuItem x:Name="ButtonAliasesEnabled" Header="Aliases Enabled" IsCheckable="True" IsChecked="{Binding ProfileSettings.AliasesEnabled}" />
                <MenuItem x:Name="ButtonTriggersEnabled" Header="Triggers Enabled" IsCheckable="True" IsChecked="{Binding ProfileSettings.TriggersEnabled}" />
                <MenuItem x:Name="ButtonReplacementTriggersEnabled" Header="Replacement Triggers Enabled" IsCheckable="True" IsChecked="{Binding ProfileSettings.ReplacementTriggersEnabled}" />
                <Separator />
                <MenuItem Click="MenuItemToolWindow_OnClick" Header="Lua Editor" Tag="Lua" />
                <MenuItem Click="MenuItemToolWindow_OnClick" Header="SQLite Query" Tag="SQLite" />
                <Separator />
                <MenuItem x:Name="ButtonVariableRepeaterVisible" Click="ButtonVariableRepeaterVisible_Click" Header="Variables Tool Window" IsCheckable="True" IsChecked="{Binding AvalonSettings.VariableRepeaterVisible}" />
                <MenuItem Click="MenuItemToolWindow_OnClick" Header="{Binding AvalonSettings.CustomTab1Label}" InputGestureText="Ctrl+1" Tag="Terminal1" />
                <MenuItem Click="MenuItemToolWindow_OnClick" Header="{Binding AvalonSettings.CustomTab2Label}" InputGestureText="Ctrl+2" Tag="Terminal2" />
                <MenuItem Click="MenuItemToolWindow_OnClick" Header="{Binding AvalonSettings.CustomTab3Label}" InputGestureText="Ctrl+3" Tag="Terminal3" />
                <MenuItem Click="MenuItemToolWindow_OnClick" Header="Bars" Tag="Bars" />
                <Separator />
                <MenuItem Click="MenuItemResetLayout_Click" Header="Reset Dock Layout" />
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem x:Name="MenuItemDeveloperTools" Header="Developer Tools" Visibility="{Binding AvalonSettings.DeveloperMode, Converter={StaticResource BoolToVisConverter}}">
                    <MenuItem Click="MenuItemManuallyLoadPlugin_Click" Header="Manually Load Plugin" InputGestureText="Ctrl+Alt+P" />
                    <MenuItem Click="MenuItemSimulateIncomingTextAsync_Click" Header="Simulate Incoming Text" />
                </MenuItem>
                <MenuItem Click="MenuItemSendTextToGameAsync_Click" Header="Send _Text to Game" />
                <MenuItem Click="MenuItemTickTimerCommands_Click" Header="Tick Timer Commands" />
                <MenuItem Click="MenuItemEditGlobalLuaFile_Click" Header="_Edit Global Lua File" />
                <MenuItem Click="MenuItemRegexTester_Click" Header="Regular Expression Tester" />
                <Separator />
                <MenuItem Click="MenuItemDatabase_OnClick" Header="Database Query Editor" />
                <MenuItem Click="MenuItemSettings_OnClick" Header="_Settings" />
                <Separator />
                <MenuItem Header="External Tools">
                    <MenuItem Click="MenuItemExternalTool_OnClick" Header="SSH" Tag="SSH" />
                    <MenuItem Click="MenuItemExternalTool_OnClick" Header="Terminal" Tag="Terminal" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Click="MenuItemDocumentation_Click" Header="Documentation" />
                <MenuItem Click="MenuItemHashCommands_Click" Header="Hash Commands" />
                <MenuItem Click="MenuItemLua_Click" Header="Lua" />
                <MenuItem Click="MenuItemSourceCode_Click" Header="Source Code" />
                <Separator />
                <MenuItem x:Name="MenuItemUpdateClient" Click="MenuItemUpdateClient_Click" Header="Update Client and Plugins" />
                <MenuItem Click="MenuItemUpdatePlugins_Click" Header="Update Plugins" />
            </MenuItem>
            </Menu>
        </DockPanel>

        <Border
            Grid.Row="2"
            Margin="4,0,4,0"
            BorderBrush="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}"
            BorderThickness="1,0,1,0">
        <ad:DockingManager x:Name="DockingManager">
            <ad:DockingManager.Theme>
                <ad:MosaicTheme />
            </ad:DockingManager.Theme>
            <ad:LayoutRoot>
                <ad:LayoutPanel Orientation="Horizontal">
                    <ad:LayoutDocumentPane>
                        <!-- Exactly one game/profile terminal is active. The back buffer is
                             a view of the same session, not another connection. -->
                        <ad:LayoutDocument
                            x:Name="GameDocument"
                            CanClose="False"
                            CanFloat="False"
                            ContentId="game-terminal"
                            IsSelected="True"
                            Title="Game">
                            <Grid x:Name="GridGame">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="Row1" Height="Auto" />
                                    <RowDefinition x:Name="Row2" Height="70*" />
                                    <RowDefinition x:Name="Row3" Height="30*" />
                                    <RowDefinition x:Name="Row4" Height="0" />
                                    <RowDefinition x:Name="Row5" Height="0" />
                                    <RowDefinition x:Name="Row6" Height="0" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="Col1" Width="*" />
                                    <ColumnDefinition x:Name="Col2" Width="0" />
                                </Grid.ColumnDefinitions>
                                <UniformGrid Grid.Row="0" Grid.RowSpan="6" Grid.ColumnSpan="2" Columns="1">
                                    <controls:AvalonTerminal
                                        x:Name="GameBackBufferTerminal"
                                        x:FieldModifier="public"
                                        Background="Black"
                                        ContextMenu="{StaticResource AvalonTerminalContextMenu}"
                                        FontFamily="{Binding TerminalFontFamily}"
                                        FontSize="{Binding AvalonSettings.TerminalFontSize}"
                                        Foreground="LightGray"
                                        IsReadOnly="True"
                                        KeyDown="Terminal_OnKeyDown"
                                        PreviewKeyDown="GameTerminal_PreviewKeyDown"
                                        PreviewMouseWheel="GameBackBufferTerminal_PreviewMouseWheel"
                                        ShowLineNumbers="{Binding AvalonSettings.ShowLineNumbersInGameTerminal}"
                                        Visibility="Collapsed"
                                        WordWrap="{Binding AvalonSettings.WordWrapTerminals}" />
                                    <controls:AvalonTerminal
                                        x:Name="GameTerminal"
                                        x:FieldModifier="public"
                                        Background="Black"
                                        ContextMenu="{StaticResource AvalonTerminalContextMenu}"
                                        FontFamily="{Binding TerminalFontFamily}"
                                        FontSize="{Binding AvalonSettings.TerminalFontSize}"
                                        Foreground="LightGray"
                                        IsReadOnly="True"
                                        KeyDown="Terminal_OnKeyDown"
                                        PreviewKeyDown="GameTerminal_PreviewKeyDown"
                                        PreviewMouseWheel="GameTerminal_PreviewMouseWheel"
                                        ShowLineNumbers="{Binding AvalonSettings.ShowLineNumbersInGameTerminal}"
                                        WordWrap="{Binding AvalonSettings.WordWrapTerminals}" />
                                </UniformGrid>
                            </Grid>
                        </ad:LayoutDocument>

                    </ad:LayoutDocumentPane>

                    <ad:LayoutAnchorablePane DockMinWidth="300" DockWidth="520">
                        <ad:LayoutAnchorable
                            x:Name="LuaTool"
                            CanClose="True"
                            CanDockAsTabbedDocument="False"
                            CanHide="True"
                            Closing="PersistentToolWindow_OnClosing"
                            ContentId="lua-editor"
                            Title="Lua Editor">
                            <controls:AvalonLuaEditor x:Name="LuaEditor" SaveButtonVisibility="Collapsed" />
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable
                            x:Name="DatabaseTool"
                            CanClose="True"
                            CanDockAsTabbedDocument="False"
                            CanHide="True"
                            Closing="PersistentToolWindow_OnClosing"
                            ContentId="sqlite-query"
                            Title="SQLite Query">
                            <mosaic:SqliteQueryControl
                                x:Name="SqliteQuery"
                                AutoCompleteEnabled="True"
                                DatabaseFilePath="{Binding ProfileSettings.SqliteDatabase}"
                                RefreshSchemaAfterQuery="True"
                                RowLimit="1000" />
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable
                            x:Name="Terminal1Tool"
                            CanClose="False"
                            ContentId="terminal-1"
                            Title="{Binding AvalonSettings.CustomTab1Label}">
                            <Border x:Name="Panel2">
                                <controls:AvalonTerminal
                                    x:Name="Terminal1"
                                    Background="Black"
                                    ContextMenu="{StaticResource AvalonTerminalContextMenu}"
                                    FontFamily="{Binding TerminalFontFamily}"
                                    FontSize="{Binding AvalonSettings.TerminalFontSize}"
                                    Foreground="LightGray"
                                    GagEnabled="False"
                                    IsReadOnly="True"
                                    KeyDown="Terminal_OnKeyDown"
                                    ShowLineNumbers="False"
                                    WordWrap="{Binding AvalonSettings.WordWrapTerminals}" />
                            </Border>
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable
                            x:Name="Terminal2Tool"
                            CanClose="False"
                            ContentId="terminal-2"
                            Title="{Binding AvalonSettings.CustomTab2Label}">
                            <controls:AvalonTerminal
                                x:Name="Terminal2"
                                Background="Black"
                                ContextMenu="{StaticResource AvalonTerminalContextMenu}"
                                FontFamily="{Binding TerminalFontFamily}"
                                FontSize="{Binding AvalonSettings.TerminalFontSize}"
                                Foreground="LightGray"
                                GagEnabled="False"
                                IsReadOnly="True"
                                KeyDown="Terminal_OnKeyDown"
                                ShowLineNumbers="False"
                                WordWrap="{Binding AvalonSettings.WordWrapTerminals}" />
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable
                            x:Name="Terminal3Tool"
                            CanClose="False"
                            ContentId="terminal-3"
                            Title="{Binding AvalonSettings.CustomTab3Label}">
                            <controls:AvalonTerminal
                                x:Name="Terminal3"
                                Background="Black"
                                ContextMenu="{StaticResource AvalonTerminalContextMenu}"
                                FontFamily="{Binding TerminalFontFamily}"
                                FontSize="{Binding AvalonSettings.TerminalFontSize}"
                                Foreground="LightGray"
                                GagEnabled="False"
                                IsReadOnly="True"
                                KeyDown="Terminal_OnKeyDown"
                                ShowLineNumbers="False"
                                WordWrap="{Binding AvalonSettings.WordWrapTerminals}" />
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable x:Name="BarsTool" CanClose="False" ContentId="bars" Title="Bars">
                            <Border x:Name="Panel1">
                                <controls:BarRepeater x:Name="BarRepeater" x:FieldModifier="public" EnableMouseClick="True" />
                            </Border>
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable
                            x:Name="VariablesTool"
                            CanClose="False"
                            ContentId="variables"
                            Title="Variables">
                            <Border x:Name="VariableRepeaterBorder">
                                <controls:VariableRepeater x:Name="VariableRepeater" x:FieldModifier="public" />
                            </Border>
                        </ad:LayoutAnchorable>
                        <ad:LayoutAnchorable
                            x:Name="SettingsTool"
                            CanClose="False"
                            ContentId="settings"
                            Title="Settings">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <mosaic:TabControl>
                                    <mosaic:TabItem Header="Profile">
                                        <mosaic:PropertyGrid x:Name="ProfilePropertyGrid" Object="{Binding ProfileSettings}" />
                                    </mosaic:TabItem>
                                    <mosaic:TabItem Header="Client">
                                        <mosaic:PropertyGrid x:Name="ClientPropertyGrid" Object="{Binding AvalonSettings}" />
                                    </mosaic:TabItem>
                                </mosaic:TabControl>
                                <Button
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    Click="ButtonApplySettings_OnClick"
                                    Content="Apply"
                                    Margin="8" />
                            </Grid>
                        </ad:LayoutAnchorable>
                    </ad:LayoutAnchorablePane>
                </ad:LayoutPanel>
            </ad:LayoutRoot>
        </ad:DockingManager>
        </Border>

        <Border x:Name="BorderInfoBar" Grid.Row="3" Margin="4,0,4,0">
            <controls:InfoBar x:Name="InfoBar" x:FieldModifier="public" />
        </Border>

        <Border x:Name="BorderTextInput" Grid.Row="4" Margin="4,0,4,0">
            <editors:AutoCompleteTextBox
                x:Name="TextInput"
                AcceptsTab="True"
                Delay="300"
                DisplayMember="Command"
                ItemTemplate="{StaticResource AutoCompleteCommandTemplate}"
                SpellCheckEnabled="{Binding SpellCheckEnabled}"
                Style="{StaticResource MaterialAutoCompleteTextBox}" />
        </Border>

        <StatusBar Grid.Row="5" Margin="4,0,4,4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Click="SqlStatus_OnClick" Content="{Binding PendingSqlStatements, StringFormat=Database: {0}}" />
                    <Button Click="LuaStatus_OnClick" Content="{Binding LuaScriptsActive, StringFormat=Lua: {0}}" />
                    <Button Click="ScheduledTaskStatus_OnClick" Content="{Binding ScheduledTasksActive, StringFormat=Tasks: {0}}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Popup x:Name="PopupAutoComplete" IsOpen="False" Placement="Left">
            <ListBox
                x:Name="PopupAutoCompleteListBox"
                KeyDown="PopupAutoCompleteListBox_OnKeyDown"
                LostFocus="PopupAutoCompleteListBox_OnLostFocus" />
        </Popup>

    </Grid>
</Window>
