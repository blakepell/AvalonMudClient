<UserControl
    x:Class="Avalon.Controls.AvalonLuaEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="AvalonLuaEditor_OnLoaded"
    Unloaded="AvalonLuaEditor_OnUnloaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBar
            Grid.Row="0"
            Background="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBackgroundBrush}}">
            <Button
                Click="ButtonSaveLua_Click"
                Content="Save"
                ToolTip="Save Lua script"
                Visibility="{Binding SaveButtonVisibility}" />
            <Button
                Click="ButtonRunLua_OnClick"
                ToolTip="Run Lua script">
                <Viewbox Width="16" Height="16">
                    <Grid Width="16" Height="16">
                        <Path Data="F1M3.777,1.084,3,1.5v12l.777.416,9-6V7.084Z" Fill="LawnGreen" />
                    </Grid>
                </Viewbox>
            </Button>
            <Separator />
            <Button
                Click="ButtonCommentOutSelection"
                ToolTip="Comment the selected Lua code">
                <!-- Comment Out Selection -->
                <Viewbox Width="16" Height="16">
                    <Grid Width="16" Height="16">
                        <!-- Code/comment lines -->
                        <Path
                            Data="M2,4 H12 V5 H2 Z
                  M2,7 H10 V8 H2 Z
                  M2,10 H12 V11 H2 Z"
                            Fill="LightGray" />

                        <!-- Slash indicating disabled/commented out -->
                        <Path
                            Data="M3,13 L12,2 L13,3 L4,14 Z"
                            Fill="OrangeRed" />
                    </Grid>
                </Viewbox>
            </Button>
            <Button
                Click="ButtonUncommentSelection"
                ToolTip="Uncomment the selected Lua code">
                <!-- Uncomment Selection -->
                <Viewbox Width="16" Height="16">
                    <Grid Width="16" Height="16">
                        <!-- Code/comment lines -->
                        <Path
                            Data="M2,4 H12 V5 H2 Z
                  M2,7 H10 V8 H2 Z
                  M2,10 H12 V11 H2 Z"
                            Fill="LightGray" />

                        <!-- Small removal/undo indicator -->
                        <Path
                            Data="M11,2 L14,5 L11,8 V6
                  C8,6 6,7 5,10
                  C5,6 7,4 11,4 Z"
                            Fill="LawnGreen" />
                    </Grid>
                </Viewbox>
            </Button>
            <Separator />
            <Button
                Click="ButtonInfo_OnClick"
                ToolTip="Show information about the Lua environment"
                Visibility="{Binding InfoButtonVisibility}">
                <Image Source="pack://application:,,,/Avalon;component/Assets/info-48.png"></Image>
            </Button>
        </ToolBar>

        <mosaic:SyntaxEditor
            x:Name="Editor"
            Grid.Row="1"
            ClearVisible="False"
            FollowGlobalTheme="True"
            IsReadOnly="False"
            KeyDown="AvalonLuaEditor_OnKeyDown"
            Language="Lua"
            ScrollViewer.PanningMode="VerticalOnly"
            ShowLineNumbers="True"
            WordWrap="False" />
    </Grid>
</UserControl>
