<UserControl
    x:Class="Avalon.Controls.AvalonLuaEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="AvalonLuaEditor_OnLoaded"
    Unloaded="AvalonLuaEditor_OnUnloaded"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBar
            Grid.Row="0"
            Background="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBackgroundBrush}}">
            <Button
                Click="ButtonSaveLua_Click"
                Content="Save"
                ToolTip="Save Lua script"
                Visibility="{Binding SaveButtonVisibility}" />
            <Button
                Click="ButtonRunLua_OnClick"
                Content="Run"
                ToolTip="Run Lua script" />
            <Separator />
            <Button
                Click="ButtonCommentOutSelection"
                Content="Comment"
                ToolTip="Comment the selected Lua code" />
            <Button
                Click="ButtonUncommentSelection"
                Content="Uncomment"
                ToolTip="Uncomment the selected Lua code" />
            <Separator />
            <Button
                Click="ButtonInfo_OnClick"
                Content="Info"
                ToolTip="Show information about the Lua environment"
                Visibility="{Binding InfoButtonVisibility}" />
        </ToolBar>

        <mosaic:SyntaxEditor
            x:Name="Editor"
            Grid.Row="1"
            ClearVisible="False"
            FollowGlobalTheme="True"
            IsReadOnly="False"
            KeyDown="AvalonLuaEditor_OnKeyDown"
            Language="Lua"
            ScrollViewer.PanningMode="VerticalOnly"
            ShowLineNumbers="True"
            WordWrap="False" />
    </Grid>
</UserControl>
