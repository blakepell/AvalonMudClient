<UserControl x:Class="Avalon.Controls.MacroList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="MacroList_OnLoaded"
             Unloaded="MacroList_OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <mosaic:AccentButton
                x:Name="ButtonNewMacro"
                Width="110"
                Margin="5,10"
                AccentButtonType="ThemeAccent"
                Click="ButtonNewMacro_Click"
                Content="New Macro" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <mosaic:SearchBox
                    x:Name="TextFilter"
                    Width="220"
                    Margin="8,10,5,10"
                    FontSize="14"
                    TextChanged="TextFilter_TextChanged"
                    Watermark="Filter" />
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="DataList" x:FieldModifier="public" MinRowHeight="32"
                  Grid.Row="1" HeadersVisibility="Column"
                  Margin="5,0,5,5"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  AutoGenerateColumns="False"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="72">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <mosaic:AccentButton
                                Margin="4,2"
                                HorizontalAlignment="Stretch"
                                AccentButtonType="ThemeAccent"
                                Click="ButtonEdit_OnClick"
                                Content="Edit" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Key Description" Binding="{Binding KeyDescription,UpdateSourceTrigger=PropertyChanged}" Width="10*" IsReadOnly="True" />
                <DataGridTextColumn Header="Command" Binding="{Binding Command,UpdateSourceTrigger=PropertyChanged}" Width="80*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
