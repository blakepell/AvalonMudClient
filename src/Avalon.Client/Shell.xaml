<Window
    x:Class="Avalon.Shell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic-ui"
    xmlns:vm="clr-namespace:Avalon"
    Title="{Binding HeaderTitle}"
    Width="800"
    Height="600"
    Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}"
    BorderThickness="0"
    Closed="ShellWindow_Closed"
    Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.WindowForegroundBrush}}"
    Loaded="ShellWindow_Loaded"
    mc:Ignorable="d"
    mosaic:WindowChromeBehavior.ApplyThemeWindowBrushes="True"
    mosaic:WindowChromeBehavior.CaptionHeight="0"
    mosaic:WindowChromeBehavior.CornerRadius="10"
    mosaic:WindowChromeBehavior.GlassFrameThickness="0"
    mosaic:WindowChromeBehavior.IsEnabled="True"
    mosaic:WindowChromeBehavior.ResizeBorderThickness="5"
    mosaic:WindowChromeBehavior.UseAeroCaptionButtons="True"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    Style="{x:Null}"
    UseLayoutRounding="True"
    d:DataContext="{d:DesignInstance {x:Type vm:DesignTimeViewModel}, IsDesignTimeCreatable=True}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <mosaic:WindowTitleBar
            Grid.Row="0"
            ShowIcon="False"
            TitleAlignment="Center"
            TitleText="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
            <mosaic:WindowTitleBar.RightContent>
                <Button
                    Width="48"
                    Click="ButtonToggleTheme_OnClick"
                    Content="&#x25D0;"
                    FontSize="17"
                    Style="{DynamicResource {x:Static mosaic:MosaicTheme.WindowTitleBarButtonStyle}}"
                    ToolTip="Toggle dark and blue themes" />
            </mosaic:WindowTitleBar.RightContent>
        </mosaic:WindowTitleBar>

        <Border Grid.Row="1" Padding="10">
            <ContentControl x:Name="Container" x:FieldModifier="public" />
        </Border>

        <StackPanel
            Grid.Row="2"
            Margin="10,0,10,10"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <mosaic:AccentButton
                x:Name="ButtonSecondary"
                MinWidth="100"
                Margin="0,0,8,0"
                AccentButtonType="Default"
                Click="ButtonSecondary_Click"
                Content="{Binding SecondaryButtonText}"
                Visibility="{Binding SecondaryButtonVisibility}" />
            <mosaic:AccentButton
                x:Name="ButtonPrimary"
                MinWidth="100"
                AccentButtonType="ThemeAccent"
                Click="ButtonPrimary_Click"
                Content="{Binding PrimaryButtonText}"
                Visibility="{Binding PrimaryButtonVisibility}" />
        </StackPanel>

        <StatusBar
            Grid.Row="3"
            Background="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBackgroundBrush}}"
            BorderBrush="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}"
            BorderThickness="0,1,0,0"
            Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.ControlTextForegroundBrush}}"
            Visibility="{Binding StatusBarVisibility}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem>
                <mosaic:ProgressRing
                    x:Name="ProgressRingUpdating"
                    Margin="0,0,5,0"
                    IsActive="{Binding ProgressRingIsActive}"
                    Visibility="{Binding ProgressRingVisibility}" />
            </StatusBarItem>
            <Separator
                Grid.Column="1"
                Width="1"
                Height="23"
                Background="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}"
                Visibility="{Binding ProgressRingVisibility}" />
            <StatusBarItem Grid.Column="2">
                <TextBlock Margin="5,0,0,0" Text="{Binding StatusBarLeftText}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="3">
                <TextBlock Margin="0,0,5,0" Text="{Binding StatusBarRightText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
