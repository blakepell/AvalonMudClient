<UserControl x:Class="Avalon.Controls.GameCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic"
    Width="344" Margin="0,0,18,18">
    <mosaic:ClipBorder CornerRadius="16" BorderThickness="1"
        BorderBrush="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}"
        Background="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBackgroundBrush}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="172"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}">
                <Border Width="78" Height="78" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="1" BorderBrush="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}"
                    Background="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBackgroundBrush}}">
                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.AccentBrush}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Image x:Name="Artwork" Stretch="UniformToFill"/>
                <Border VerticalAlignment="Bottom" Height="65" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000"/>
                            <GradientStop Color="#B3000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16">
                    <Border Background="{Binding AccentBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Genre}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Genre}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Genre}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#DB182333" CornerRadius="4" Padding="8,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlayStyle}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding PlayStyle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding PlayStyle}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="20">
                <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,0,16"/>
                <Border CornerRadius="7" Padding="10,8" Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Padding="6" Click="CopyAddress_OnClick" ToolTip="Copy server address" AutomationProperties.Name="Copy server address"/>
                        <TextBlock Text="{Binding Address}" FontFamily="Consolas" FontSize="13" Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.ControlTextForegroundBrush}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Address}"/>
                    </DockPanel>
                </Border>
                <TextBlock Text="{Binding Description}" Height="104" Margin="0,16,0,16" FontSize="13"
                    TextWrapping="Wrap" TextTrimming="WordEllipsis" LineHeight="23" LineStackingStrategy="BlockLineHeight"
                    Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.ControlTextSecondaryForegroundBrush}}"/>
                <Border Height="1" Background="{DynamicResource {x:Static mosaic:MosaicTheme.ControlBorderBrush}}"/>
                <DockPanel Margin="0,12,0,0">
                    <mosaic:SplitButton DockPanel.Dock="Right" Content="Options" Click="Edit_OnClick" Padding="10,5">
                        <mosaic:SplitButton.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit" Click="Edit_OnClick"/>
                                <MenuItem Header="Delete" Click="Delete_OnClick"/>
                            </ContextMenu>
                        </mosaic:SplitButton.ContextMenu>
                    </mosaic:SplitButton>
                    <Button DockPanel.Dock="Left" Margin="0,0,12,0" Content="Connect" Click="Connect_OnClick" Padding="10,5"/>
                    <TextBlock Text="{Binding Plays, StringFormat={}{0} plays}" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.ControlTextSecondaryForegroundBrush}}"/>
                </DockPanel>
            </StackPanel>
        </Grid>
    </mosaic:ClipBorder>
</UserControl>
