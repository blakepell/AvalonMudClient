<UserControl
    x:Class="Avalon.Controls.GamesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:controls="clr-namespace:Avalon.Controls"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <CollectionViewSource
            x:Key="GamesView"
            Filter="GamesView_OnFilter"
            IsLiveFilteringRequested="True"
            IsLiveSortingRequested="True"
            Source="{Binding Games}">
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="LastPlayed" Direction="Descending" />
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.LiveFilteringProperties>
                <sys:String>Name</sys:String>
                <sys:String>IpAddress</sys:String>
                <sys:String>Port</sys:String>
                <sys:String>Description</sys:String>
                <sys:String>Genre</sys:String>
                <sys:String>PlayStyle</sys:String>
            </CollectionViewSource.LiveFilteringProperties>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock
                FontSize="26"
                FontWeight="Light"
                Text="Shall we play a game?" />
            <TextBlock
                Margin="0,8,0,0"
                Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
                Text="Your next adventure starts here." />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,24,0,20">
            <mosaic:SplitButton
                Margin="16,0,0,0"
                Padding="14,6"
                Click="NewGame_OnClick"
                Content="Add Game"
                DockPanel.Dock="Right">
                <mosaic:SplitButton.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="NewGame_OnClick" Header="New Game" />
                        <MenuItem Header="Download Games List" IsEnabled="False" />
                    </ContextMenu>
                </mosaic:SplitButton.ContextMenu>
            </mosaic:SplitButton>
            <mosaic:SearchBox
                x:Name="GameSearch"
                Width="360"
                Padding="4,0,0,2"
                HorizontalAlignment="Left"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="Search games"
                ClearTextOnEnter="False"
                TextChanged="GameSearch_OnTextChanged"
                Watermark="Search games, hosts, genres…" />
        </DockPanel>
        <Grid Grid.Row="2">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GameItems" ItemsSource="{Binding Source={StaticResource GamesView}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:GameCard DeleteRequested="GameCard_OnDeleteRequested" EditRequested="GameCard_OnEditRequested" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock
                Margin="0,24,0,0"
                VerticalAlignment="Top"
                Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.ControlTextSecondaryForegroundBrush}}"
                Text="No games found. Add a game or try a different search."
                TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count, ElementName=GameItems}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>

