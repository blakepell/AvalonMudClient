<UserControl
    x:Class="Avalon.Controls.MainWindowStatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Avalon.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Avalon.Models"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic"
    xmlns:vm="clr-namespace:Avalon.ViewModels"
    d:DesignHeight="25"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <common:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <common:BoolToIconConverter x:Key="BoolToIconConverter" />

        <!--  A flat, label-only button like Actipro's ribbon button in its StatusBarItem context.  -->
        <Style x:Key="StatusBarButton" TargetType="Button">
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="2,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=StatusBarItem}}" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static mosaic:MosaicTheme.RibbonItemHoverBackgroundBrush}}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static mosaic:MosaicTheme.RibbonItemHoverBorderBrush}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static mosaic:MosaicTheme.RibbonItemPressedBackgroundBrush}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  The small - and + buttons on either side of the zoom slider.  -->
        <Style x:Key="SliderStepButton" TargetType="RepeatButton">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="1,0,1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=StatusBarItem}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static mosaic:MosaicTheme.RibbonItemHoverBackgroundBrush}}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource {x:Static mosaic:MosaicTheme.RibbonItemHoverBorderBrush}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource {x:Static mosaic:MosaicTheme.RibbonItemPressedBackgroundBrush}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleIcon" TargetType="Image">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>
    </UserControl.Resources>

    <StatusBar
        Height="25"
        d:DataContext="{d:DesignInstance Type=models:AppViewModel}"
        FocusManager.IsFocusScope="True">
        <StatusBar.ItemsPanel>
            <ItemsPanelTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ItemsPanelTemplate>
        </StatusBar.ItemsPanel>

        <StatusBarItem Grid.Column="0" Padding="5,0,5,0">
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        </StatusBarItem>

        <!--  Fill Space  -->
        <StatusBarItem Grid.Column="1" HorizontalContentAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <!--  Running scripts  -->
                <StackPanel
                    Margin="0,0,10,0"
                    Orientation="Horizontal"
                    ToolTip="Scripts currently running">
                    <mosaic:AdaptiveImage
                        Width="16"
                        Height="16"
                        Margin="0,0,4,0"
                        Source="/Assets/vs-script-16.png" />
                    <TextBlock VerticalAlignment="Center">
                        <TextBlock.Text>
                            <PriorityBinding>
                                <Binding Path="ActiveTerminal.ScriptsActive" />
                                <Binding Path="StandaloneScriptsActive" />
                            </PriorityBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <!--  Current character  -->
                <Button
                    Padding="4,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Static vm:AppCommands.SetCurrentCharacterCommand}"
                    ToolTip="Set the current character"
                    Visibility="{Binding ActiveTerminal, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="16"
                            Height="16"
                            Margin="0,0,4,0"
                            Source="/Assets/profile-32.png" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding ActiveTerminal.Character, TargetNullValue='No Character', FallbackValue=''}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StatusBarItem>

        <Separator Grid.Column="2" Visibility="{Binding ActiveTerminal, Converter={StaticResource NullToVisibilityConverter}}" />

        <!--  Triggers  -->
        <StatusBarItem Grid.Column="3">
            <StackPanel Orientation="Horizontal" Visibility="{Binding ActiveTerminal, Converter={StaticResource NullToVisibilityConverter}}">
                <Image Source="{Binding ActiveTerminal.Game.TriggersEnabled, Converter={StaticResource BoolToIconConverter}, FallbackValue='pack://application:,,,/Assets/circle-x-24.png'}" Style="{StaticResource ToggleIcon}" />
                <Button
                    Click="ButtonToggleTriggers_Click"
                    Content="Triggers"
                    Style="{StaticResource StatusBarButton}"
                    ToolTip="Toggle Triggers" />
            </StackPanel>
        </StatusBarItem>

        <Separator Grid.Column="4" Visibility="{Binding ActiveTerminal, Converter={StaticResource NullToVisibilityConverter}}" />

        <!--  Aliases  -->
        <StatusBarItem Grid.Column="5">
            <StackPanel Orientation="Horizontal" Visibility="{Binding ActiveTerminal, Converter={StaticResource NullToVisibilityConverter}}">
                <Image Source="{Binding ActiveTerminal.Game.AliasesEnabled, Converter={StaticResource BoolToIconConverter}, FallbackValue='pack://application:,,,/Assets/circle-x-24.png'}" Style="{StaticResource ToggleIcon}" />
                <Button
                    Click="ButtonToggleAliases_Click"
                    Content="Aliases"
                    Style="{StaticResource StatusBarButton}"
                    ToolTip="Toggle Aliases" />
            </StackPanel>
        </StatusBarItem>

        <Separator Grid.Column="6" Visibility="{Binding ActiveTerminal, Converter={StaticResource NullToVisibilityConverter}}" />

        <!--  GMCP  -->
        <StatusBarItem Grid.Column="7">
            <StackPanel Orientation="Horizontal" Visibility="{Binding ActiveTerminal, Converter={StaticResource NullToVisibilityConverter}}">
                <Image Source="{Binding ActiveTerminal.Game.GmcpEnabled, Converter={StaticResource BoolToIconConverter}, FallbackValue='pack://application:,,,/Assets/circle-x-24.png'}" Style="{StaticResource ToggleIcon}" />
                <Button
                    Click="ButtonToggleGmcp_Click"
                    Content="GMCP"
                    Style="{StaticResource StatusBarButton}"
                    ToolTip="Toggle GMCP" />
            </StackPanel>
        </StatusBarItem>

        <Separator Grid.Column="8" Visibility="{Binding ActiveTerminal, Converter={StaticResource NullToVisibilityConverter}}" />

        <!--  Connection  -->
        <StatusBarItem Grid.Column="9" ToolTip="Game Server Connection Information">
            <StackPanel Orientation="Horizontal" Visibility="{Binding ActiveTerminal, Converter={StaticResource NullToVisibilityConverter}}">
                <mosaic:AdaptiveImage Margin="0,0,5,0" Stretch="None">
                    <mosaic:AdaptiveImage.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="pack://application:,,,/Assets/vs-disconnected-16.png" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTerminal.IsConnected}" Value="True">
                                    <Setter Property="Source" Value="pack://application:,,,/Assets/vs-connected-16.png" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </mosaic:AdaptiveImage.Style>
                </mosaic:AdaptiveImage>
                <TextBlock Text="{Binding ActiveTerminal.Game.IpAddress}" />
                <TextBlock Text=":" />
                <TextBlock Text="{Binding ActiveTerminal.Game.Port}" />
            </StackPanel>
        </StatusBarItem>

        <Separator Grid.Column="10" Visibility="{Binding ActiveTerminal, Converter={StaticResource NullToVisibilityConverter}}" />

        <!--  Terminal font size  -->
        <StatusBarItem Grid.Column="11" Padding="4,0,4,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AppSettings.TerminalFontSize, FallbackValue=14}" />
                    <TextBlock Text="pt" />
                </StackPanel>

                <RepeatButton
                    Command="Slider.DecreaseSmall"
                    CommandTarget="{Binding ElementName=ScaleSlider}"
                    Style="{StaticResource SliderStepButton}"
                    ToolTip="Zoom Out">
                    <Path
                        Data="M0,0.5 L8,0.5"
                        SnapsToDevicePixels="True"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                        StrokeThickness="1" />
                </RepeatButton>
                <Slider
                    x:Name="ScaleSlider"
                    Width="100"
                    VerticalAlignment="Center"
                    Focusable="False"
                    IsSnapToTickEnabled="True"
                    LargeChange="2.0"
                    Maximum="24.0"
                    Minimum="8.0"
                    SmallChange="1.0"
                    TickFrequency="1.0"
                    ToolTip="Zoom"
                    Value="{Binding AppSettings.TerminalFontSize, FallbackValue=14}" />
                <RepeatButton
                    Command="Slider.IncreaseSmall"
                    CommandTarget="{Binding ElementName=ScaleSlider}"
                    Style="{StaticResource SliderStepButton}"
                    ToolTip="Zoom In">
                    <Path
                        Data="M0,4.5 L8,4.5 M4,0.5 L4,8.5"
                        SnapsToDevicePixels="True"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                        StrokeThickness="1" />
                </RepeatButton>
            </StackPanel>
        </StatusBarItem>
    </StatusBar>
</UserControl>
