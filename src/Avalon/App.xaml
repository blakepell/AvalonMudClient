<mosaic:MosaicApp
    x:Class="Avalon.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:Avalon.Models"
    xmlns:mosaic="clr-namespace:Mosaic.UI.Wpf;assembly=Mosaic.UI.Wpf"
    xmlns:themes="http://schemas.apexgate.net/wpf/mosaic-ui"
    x:TypeArguments="models:AppSettings,models:AppViewModel"
    Exit="App_OnExit"
    Startup="App_OnStartup"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <themes:ThemeManager
                    Native="True"
                    SystemColors="True"
                    Theme="Black" />
                <ResourceDictionary Source="/Themes/Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource GridViewItemContainerStyleKey}" TargetType="{x:Type ListViewItem}">
                <Setter Property="Padding" Value="6,1" />
            </Style>
            <!--
                The stock ComboBoxItem style binds its content alignment to an ancestor ItemsControl, which logs
                binding errors whenever an item is detached from one.  Static values avoid that lookup.
            -->
            <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="{x:Type ComboBoxItem}">
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
            <models:AppViewModelLocator x:Key="AppViewModel" />
        </ResourceDictionary>
    </Application.Resources>
</mosaic:MosaicApp>
