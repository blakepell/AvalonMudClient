                        </mosaic:RibbonMenuButton>

                        <!--  Macros  -->
                        <mosaic:RibbonMenuButton
                            Key="Macros"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            mosaic:RibbonKeyTipService.KeyTip="M"
                            Label="Macros"
                            LargeImage="/Assets/keyboard-48.png"
                            Loaded="AppearanceButton_OnLoaded"
                            SmallImage="/Assets/keyboard-48.png">
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.NewMacroCommand}"
                                Header="New Macro"
                                SmallImage="/Assets/add-48.png" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.EditMacrosCommand}"
                                Header="Edit Macros"
                                SmallImage="/Assets/edit-property-48.png" />
                        </mosaic:RibbonMenuButton>

                        <!--  Scripts  -->
                        <mosaic:RibbonMenuButton
                            Key="Scripts"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            mosaic:RibbonKeyTipService.KeyTip="S"
                            Label="Scripts"
