                                Command="{x:Static vm:AppCommands.NewVariableCommand}"
                                Header="New Variable"
                                SmallImage="/Assets/add-48.png" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.EditVariablesCommand}"
                                Header="Edit Variables"
                                SmallImage="/Assets/edit-property-48.png" />
                        </mosaic:RibbonMenuButton>

                        <mosaic:RibbonButton
                            Key="Notes"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            mosaic:RibbonKeyTipService.KeyTip="N"
                            Command="{x:Static vm:AppCommands.ShowNotesCommand}"
                            Label="Notes"
                            LargeImage="/Assets/notebook-48.png"
                            SmallImage="/Assets/notebook-48.png" />
                    </mosaic:RibbonGroup>

                    <mosaic:RibbonGroup Header="UI">
                        <!--  Terminal  -->
                        <mosaic:RibbonMenuButton
                            Key="Terminal"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            Label="Terminal"
                            LargeImage="/Assets/terminal-48.png"
                            Loaded="AppearanceButton_OnLoaded"
                            SmallImage="/Assets/terminal-48.png">
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.NewTerminalCommand}"
                                Header="New Terminal"
                                SmallImage="/Assets/terminal-48.png" />
                            <Separator />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.SendMultilineCommand}"
                                Header="Send Multiline Text to Terminal"
                                SmallImage="/Assets/assignment-send-48.png" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.SimulateIncomingCommand}"
                                Header="Simulate Incoming Text"
                                SmallImage="/Assets/assignment-return-48.png" />
                        </mosaic:RibbonMenuButton>

                        <!--  Theme  -->
                        <mosaic:RibbonSplitButton
                            Key="Theme"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            Click="ButtonToggleTheme_OnClick"
                            Label="Theme"
                            LargeImage="/Assets/theme-48.png"
                            Loaded="AppearanceButton_OnLoaded"
                            SmallImage="/Assets/theme-48.png">
                            <controls:RibbonMenuHeading Header="Application Theme" Style="{StaticResource RibbonMenuHeadingStyle}" />
                            <mosaic:RibbonMenuItem
                                Click="SetTheme_OnClick"
                                Header="Light"
                                SmallImage="{StaticResource LightThemeSwatch}"
                                Tag="{x:Static mosaicCore:MosaicThemeMode.Light}" />
                            <mosaic:RibbonMenuItem
                                Click="SetTheme_OnClick"
                                Header="Dark"
                                SmallImage="{StaticResource DarkThemeSwatch}"
                                Tag="{x:Static mosaicCore:MosaicThemeMode.Dark}" />
                            <mosaic:RibbonMenuItem
                                Click="SetTheme_OnClick"
                                Header="Black"
                                SmallImage="{StaticResource BlackThemeSwatch}"
                                Tag="{x:Static mosaicCore:MosaicThemeMode.Black}" />
                            <mosaic:RibbonMenuItem
                                Click="SetTheme_OnClick"
                                Header="Blue"
                                SmallImage="{StaticResource BlueThemeSwatch}"
                                Tag="{x:Static mosaicCore:MosaicThemeMode.Blue}" />
                            <mosaic:RibbonMenuItem
                                Click="SetTheme_OnClick"
                                Header="High Contrast"
                                SmallImage="{StaticResource HighContrastThemeSwatch}"
                                Tag="{x:Static mosaicCore:MosaicThemeMode.HighContrast}" />
                            <Separator />
                            <controls:RibbonMenuHeading Header="Terminal Colors" Style="{StaticResource RibbonMenuHeadingStyle}" />
                            <mosaic:RibbonMenuItem
                                Click="EditTerminalColors_OnClick"
                                Header="Edit Terminal Colors"
                                SmallImage="/Assets/vs-color-wheel-16.png"
                                UseAdaptiveSmallImage="True" />
                            <mosaic:RibbonMenuItem
                                Click="ResetTerminalColors_OnClick"
                                Header="Reset Terminal Colors"
                                SmallImage="/Assets/vs-color-dialog-16.png"
                                UseAdaptiveSmallImage="True" />
                        </mosaic:RibbonSplitButton>

                        <!--  Layout  -->
                        <mosaic:RibbonMenuButton
                            Key="Layout"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            mosaic:RibbonKeyTipService.KeyTip="L"
                            Label="Layout"
                            LargeImage="/Assets/collage-96.png"
                            Loaded="AppearanceButton_OnLoaded"
                            SmallImage="/Assets/collage-96.png">
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.ResetLayoutCommand}"
                                Header="Reset Layout"
                                SmallImage="/Assets/reset-48.png" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.NewTerminalCommand}"
                                Header="Add New Terminal"
                                SmallImage="/Assets/terminal-48.png" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.AddVitalsPanelCommand}"
                                Header="Add Vitals Panel" />
                            <Separator />
                            <controls:RibbonMenuHeading Header="Tool Windows" Style="{StaticResource RibbonMenuHeadingStyle}" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.ShowToolWindowCommand}"
                                CommandParameter="{x:Static vm:ToolWindows.Variables}"
                                Header="Show Variables"
                                SmallImage="/Assets/vs-member-variable-16.png"
                                UseAdaptiveSmallImage="True" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.ShowToolWindowCommand}"
                                CommandParameter="{x:Static vm:ToolWindows.AliasButtons}"
                                Header="Show Alias Buttons"
                                SmallImage="/Assets/vs-replace-all-16.png"
                                UseAdaptiveSmallImage="True" />
