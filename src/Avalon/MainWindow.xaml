                                Command="{x:Static vm:AppCommands.ShowToolWindowCommand}"
                                CommandParameter="{x:Static vm:ToolWindows.Properties}"
                                Header="Show Properties"
                                SmallImage="/Assets/vs-property-document-16.png"
                                UseAdaptiveSmallImage="True" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.ShowToolWindowCommand}"
                                CommandParameter="{x:Static vm:ToolWindows.Log}"
                                Header="Show Log"
                                SmallImage="/Assets/vs-log-16.png"
                                UseAdaptiveSmallImage="True" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.ShowToolWindowCommand}"
                                CommandParameter="{x:Static vm:ToolWindows.Notes}"
                                Header="Show Notes"
                                SmallImage="/Assets/vs-notepad-16.png" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.ShowToolWindowCommand}"
                                CommandParameter="{x:Static vm:ToolWindows.ColorTheme}"
                                Header="Show Color Theme"
                                SmallImage="/Assets/vs-color-palette-16.png"
                                UseAdaptiveSmallImage="True" />
                            <Separator />
                            <controls:RibbonMenuHeading Header="Layout Options" Style="{StaticResource RibbonMenuHeadingStyle}" />
                            <mosaic:RibbonMenuItem
                                Click="SetRibbonLayout_OnClick"
                                Header="Classic Ribbon"
                                Tag="{x:Static mosaic:RibbonLayoutMode.Classic}" />
                            <mosaic:RibbonMenuItem
                                Click="SetRibbonLayout_OnClick"
                                Header="Simplified Ribbon"
                                Tag="{x:Static mosaic:RibbonLayoutMode.Simplified}" />
                        </mosaic:RibbonMenuButton>
                    </mosaic:RibbonGroup>
                </mosaic:RibbonTabItem>

                <!--  ============================  DEVELOPER  ============================  -->
                <mosaic:RibbonTabItem mosaic:RibbonKeyTipService.KeyTip="D" Header="Developer">
                    <mosaic:RibbonGroup Header="Developer">
                        <!--  Packages  -->
                        <mosaic:RibbonMenuButton
                            Key="Packages"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            Label="Packages"
                            LargeImage="/Assets/package-48.png"
                            Loaded="AppearanceButton_OnLoaded"
                            SmallImage="/Assets/package-48.png">
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.NewPackageCommand}"
                                Header="New Package"
                                SmallImage="/Assets/add-48.png" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.EditPackagesCommand}"
                                Header="Edit Packages"
                                SmallImage="/Assets/edit-property-48.png" />
                            <Separator />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.CompilePackageCommand}"
                                Header="Compile Package"
                                SmallImage="/Assets/package-add-48.png" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.ImportPackageCommand}"
                                Header="Import Package from File"
                                SmallImage="/Assets/package-refresh-48.png" />
                        </mosaic:RibbonMenuButton>

                        <mosaic:RibbonButton
                            Key="RegexTester"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            Command="{x:Static vm:AppCommands.ShowRegexTesterCommand}"
                            Label="Regex Tester"
                            LargeImage="/Assets/regex-48.png"
                            SmallImage="/Assets/regex-48.png" />

                        <mosaic:RibbonButton
                            Key="InteractiveScriptEditor"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            Command="{x:Static vm:AppCommands.NewInteractiveScriptEditorCommand}"
                            Label="Interactive Script Editor"
                            LargeImage="/Assets/javascript-48.png"
                            SmallImage="/Assets/javascript-48.png" />

                        <mosaic:RibbonButton
                            Key="LogViewer"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            Command="{x:Static vm:AppCommands.ShowToolWindowCommand}"
                            CommandParameter="{x:Static vm:ToolWindows.Log}"
                            Label="Log Viewer"
                            LargeImage="/Assets/log-file-64.png"
                            SmallImage="/Assets/log-file-64.png" />

                        <mosaic:RibbonButton
                            Key="SqliteQueryEditor"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            Command="{x:Static vm:AppCommands.SqliteQueryEditorCommand}"
                            Label="SQLite Query Editor"
                            LargeImage="/Assets/database-48.png"
                            SmallImage="/Assets/database-48.png" />
                    </mosaic:RibbonGroup>
                </mosaic:RibbonTabItem>

                <!--  ============================  HELP  ============================  -->
                <mosaic:RibbonTabItem mosaic:RibbonKeyTipService.KeyTip="H" Header="Help">
                    <mosaic:RibbonGroup Header="Documentation">
                        <mosaic:RibbonMenuButton
                            Key="Documentation"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            Label="Documentation"
                            LargeImage="/Assets/books-48.png"
                            Loaded="AppearanceButton_OnLoaded"
                            SmallImage="/Assets/books-48.png">
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.ShowUserGuideCommand}"
                                Header="Table of Contents"
                                SmallImage="/Assets/books-48.png" />
                            <mosaic:RibbonMenuItem
                                Command="{x:Static vm:AppCommands.ShowDocumentationCommand}"
                                CommandParameter="Scripting.md"
                                Header="Scripting Reference"
                                SmallImage="/Assets/javascript-48.png" />
                        </mosaic:RibbonMenuButton>
                        <mosaic:RibbonButton
                            Key="KeyboardShortcuts"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            Command="{x:Static vm:AppCommands.ShowDocumentationCommand}"
                            CommandParameter="KeyboardShortcuts.md"
                            Label="Keyboard Shortcuts"
                            LargeImage="/Assets/books-48.png"
                            SmallImage="/Assets/books-48.png" />
                        <mosaic:RibbonButton
                            Key="HashCommands"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            Command="{x:Static vm:AppCommands.ShowDocumentationCommand}"
                            CommandParameter="HashCommands.md"
                            Label="Hash Commands"
                            LargeImage="/Assets/notebook-48.png"
                            SmallImage="/Assets/notebook-48.png" />
                    </mosaic:RibbonGroup>
                    <mosaic:RibbonGroup Header="Fix">
                        <mosaic:RibbonButton
                            Key="FixDuplicateIds"
                            mosaic:RibbonItem.VariantBehavior="AlwaysLarge"
                            Command="{x:Static vm:AppCommands.FixDuplicateIdsCommand}"
                            Label="Fix Duplicate IDs"
                            LargeImage="/Assets/bug-48.png"
                            SmallImage="/Assets/bug-48.png" />
                    </mosaic:RibbonGroup>
                </mosaic:RibbonTabItem>

                <!--  Ribbon Footer (Continuum's InfoBar)  -->
                <mosaic:Ribbon.FooterContent>
                    <controls:InfoBar
                        Title="{Binding AlertTitle}"
                        Margin="4,2,4,4"
                        IsOpen="{Binding AlertVisible, Mode=TwoWay}"
                        Message="{Binding AlertMessage}"
                        Severity="{Binding AlertSeverity}" />
                </mosaic:Ribbon.FooterContent>
            </mosaic:Ribbon>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ad:DockingManager x:Name="WorkspaceDock" ActiveContentChanged="WorkspaceDock_OnActiveContentChanged">
                    <ad:DockingManager.Theme>
                        <ad:MosaicTheme />
                    </ad:DockingManager.Theme>
                    <ad:LayoutRoot>
                        <ad:LayoutPanel Orientation="Horizontal">
                            <ad:LayoutDocumentPane x:Name="GameDocumentPane" />
                        </ad:LayoutPanel>
                    </ad:LayoutRoot>
                </ad:DockingManager>

                <!--  Status bar, matching Continuum's MainWindowStatusBar  -->
                <controls:MainWindowStatusBar Grid.Row="1" />
            </Grid>
        </mosaic:RibbonContainerPanel>
    </Grid>
</Window>
