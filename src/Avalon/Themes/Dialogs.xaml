<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mosaic="http://schemas.apexgate.net/wpf/mosaic">

    <!--
        The chrome every Avalon dialog uses: the Mosaic title bar over the window content, in the current
        theme's window brushes.  Derived windows opt in with Style="{StaticResource DialogWindowStyle}".
    -->
    <Style x:Key="DialogWindowStyle" TargetType="Window">
        <Style.Resources>
            <!--  WindowChromeBehavior resolves this key when it applies native corners.  -->
            <ControlTemplate x:Key="{x:Static mosaic:MosaicTheme.RoundedWindowTemplate}" TargetType="Window">
                <mosaic:ClipBorder
                    x:Name="WindowBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding mosaic:WindowChromeBehavior.CornerRadius}">
                    <DockPanel>
                        <mosaic:WindowTitleBar
                            x:Name="TitleBar"
                            Height="36"
                            DockPanel.Dock="Top"
                            IconSource="/Assets/app.png"
                            ShowMinimizeButton="False"
                            TitleText="{TemplateBinding Title}" />
                        <AdornerDecorator>
                            <ContentPresenter />
                        </AdornerDecorator>
                    </DockPanel>
                </mosaic:ClipBorder>
                <ControlTemplate.Triggers>
                    <Trigger Property="mosaic:WindowChromeBehavior.IsNativeCornerMode" Value="True">
                        <Setter TargetName="WindowBorder" Property="CornerRadius" Value="0" />
                        <Setter TargetName="WindowBorder" Property="BorderThickness" Value="0" />
                    </Trigger>
                    <Trigger Property="WindowState" Value="Maximized">
                        <Setter TargetName="WindowBorder" Property="CornerRadius" Value="0" />
                        <Setter TargetName="WindowBorder" Property="Padding" Value="{x:Static SystemParameters.WindowResizeBorderThickness}" />
                    </Trigger>
                    <Trigger Property="ResizeMode" Value="NoResize">
                        <Setter TargetName="TitleBar" Property="ShowMaxRestoreButton" Value="False" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Style.Resources>
        <Setter Property="mosaic:WindowChromeBehavior.IsEnabled" Value="True" />
        <Setter Property="mosaic:WindowChromeBehavior.CaptionHeight" Value="0" />
        <Setter Property="mosaic:WindowChromeBehavior.CornerRadius" Value="8" />
        <Setter Property="mosaic:WindowChromeBehavior.GlassFrameThickness" Value="0" />
        <Setter Property="mosaic:WindowChromeBehavior.ResizeBorderThickness" Value="5" />
        <Setter Property="mosaic:WindowChromeBehavior.UseAeroCaptionButtons" Value="False" />
        <Setter Property="Background" Value="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBorderBrush}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static mosaic:MosaicTheme.WindowForegroundBrush}}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Template" Value="{StaticResource {x:Static mosaic:MosaicTheme.RoundedWindowTemplate}}" />
    </Style>

    <Style x:Key="MultilineDialogStyle" TargetType="mosaic:ModalDialog">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="mosaic:ModalDialog">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="32" Direction="270" Opacity="0.45" ShadowDepth="8" />
                            </Border.Effect>
                        </Border>
                        <mosaic:ClipBorder
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <DockPanel>
                                <DockPanel
                                    Height="36"
                                    Background="{DynamicResource {x:Static mosaic:MosaicTheme.WindowBackgroundBrush}}"
                                    DockPanel.Dock="Top">
                                    <Button
                                        x:Name="PART_CloseButton"
                                        AutomationProperties.Name="Close"
                                        Content="&#xE8BB;"
                                        DockPanel.Dock="Right"
                                        FontFamily="Segoe MDL2 Assets"
                                        Style="{DynamicResource {x:Static mosaic:MosaicTheme.WindowTitleBarCloseButtonStyle}}"
                                        ToolTip="Close" />
                                    <TextBlock
                                        Margin="12,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource {x:Static mosaic:MosaicTheme.WindowForegroundBrush}}"
                                        Text="{TemplateBinding Title}"
                                        TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </DockPanel>
                        </mosaic:ClipBorder>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowCloseButton" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The footer button row used by the dialogs (OK / Cancel).  -->
    <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <!--  A 16px icon + label used in menus and toolbars.  -->
    <Style x:Key="ToolbarIconStyle" TargetType="Image">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>
</ResourceDictionary>
